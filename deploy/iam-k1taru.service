[Unit]
Description=IAM-K1taru static portfolio
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=k1taru
Group=k1taru
WorkingDirectory=/home/k1taru/IAM-K1taru
Environment=NODE_ENV=production
Environment=ASTRO_TELEMETRY_DISABLED=1
EnvironmentFile=-/home/k1taru/IAM-K1taru/.env
Environment=PATH=/home/k1taru/.nvm/versions/node/v25.8.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStartPre=/usr/bin/test -f /home/k1taru/IAM-K1taru/dist/index.html
ExecStart=/usr/bin/env node scripts/serve.mjs
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
UMask=0027

[Install]
WantedBy=multi-user.target
