[Unit]
Description=IAM-K1taru static portfolio
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=k1taru
Group=k1taru
WorkingDirectory=/home/k1taru/Workspace/K1taru/IAM-K1taru
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4321
Environment=PATH=/home/k1taru/.nvm/versions/node/v25.8.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStartPre=/usr/bin/env npm run build:linux
ExecStart=/usr/bin/env npm run serve
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/k1taru/Workspace/K1taru/IAM-K1taru
UMask=0027

[Install]
WantedBy=multi-user.target
