---
import { withBasePath } from '@/utils/urls';

interface Props { currentPath: string }
const { currentPath } = Astro.props;
const links = [
  { href: '/', label: 'Home' },
  { href: '/projects/', label: 'Projects' },
  { href: '/about/', label: 'About' }
];
const isActive = (href: string) => {
  const resolvedHref = withBasePath(href);

  return resolvedHref === withBasePath('/') ? currentPath === resolvedHref : currentPath.startsWith(resolvedHref);
};
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={withBasePath('/')} aria-label="IAM-K1taru home">
      <span class="brand-mark" aria-hidden="true">K1</span>
      <span class="brand-word">IAM-K1taru</span>
    </a>
    <div class="header-controls">
      <span class="header-status" aria-label="Portfolio system online"><i aria-hidden="true"></i> System online</span>
      <nav aria-label="Primary navigation">
        <ul class="nav-list">
          {links.map((link) => (
            <li><a href={withBasePath(link.href)} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</header>
