---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import ProjectConstellation from '@/components/ProjectConstellation.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CertificationCollection from '@/components/CertificationCollection.astro';
import { site, skillGroups } from '@/data/site';
import { withBasePath } from '@/utils/urls';

const projects = (await getCollection('projects'))
  .filter((project) => !project.data.draft)
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.year - a.data.year);
const featured = projects.filter((project) => project.data.featured);
---

<BaseLayout>
  <section class="hero">
    <div class="shell hero-grid grid items-center gap-12 lg:grid-cols-[minmax(0,1.18fr)_minmax(310px,.82fr)] lg:gap-20">
      <div class="hero-content">
        <div class="hero-system-line" aria-hidden="true"><span>SYS / 01</span><i></i><span>PORTFOLIO CORE</span><i></i><span>ACTIVE</span></div>
        <div class="availability"><span class="availability-dot" aria-hidden="true"></span>Applied ML · full-stack systems · edge deployment</div>
        <h1>
          <span class="hero-first">Hello, I’m</span>
          <span>John Michael</span>
          <span class="hero-accent">Garcia.</span>
        </h1>
        <p class="hero-copy">{site.positioning}</p>
        <div class="hero-actions">
          <a class="button" href="#featured-work">View my work <span aria-hidden="true">↓</span></a>
          <a class="button button-secondary" href={`mailto:${site.email}`}>Contact me <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <div class="portrait-stage" aria-label="Portrait of John Michael Garcia">
        <div class="portrait-reticle" aria-hidden="true"><span></span><span></span><span></span></div>
        <div class="portrait-orbit portrait-orbit-one" aria-hidden="true"></div>
        <div class="portrait-orbit portrait-orbit-two" aria-hidden="true"></div>
        <div class="portrait-card" data-holo-card>
          <div class="portrait-meta"><span>IAM-K1taru / profile</span><span>2026</span></div>
          <div class="portrait-image-wrap">
            <img
              class="portrait-image"
              src={withBasePath('/images/formal-profile.jpg')}
              width="767"
              height="767"
              alt="John Michael Garcia wearing formal business attire"
              fetchpriority="high"
            />
            <span class="portrait-coordinates" aria-hidden="true">14.5995° N / 120.9842° E</span>
          </div>
          <div class="portrait-footer">
            <span><i aria-hidden="true"></i> Available for opportunities</span>
            <span>PH / UTC+8</span>
          </div>
        </div>
        <div class="floating-chip floating-chip-left" aria-hidden="true"><span>01</span> Applied ML</div>
        <div class="floating-chip floating-chip-right" aria-hidden="true"><span>02</span> Full stack</div>
        <div class="telemetry telemetry-left" aria-hidden="true"><span>CPU</span><i></i><b>OPTIMAL</b></div>
        <div class="telemetry telemetry-right" aria-hidden="true"><span>NODE</span><i></i><b>PH-08</b></div>
      </div>
    </div>
  </section>

  <div class="proof-strip" aria-label="Portfolio summary">
    <div class="proof-item"><strong>8 documented projects</strong><span>Selected for relevance and evidence</span></div>
    <div class="proof-item"><strong>Model → product</strong><span>From training workflows to usable interfaces</span></div>
    <div class="proof-item"><strong>Self-hosted systems</strong><span>Linux, Raspberry Pi, and Cloudflare</span></div>
    <div class="proof-item"><strong>Philippines</strong><span>Computer Engineering · Data Science</span></div>
  </div>

  <section class="page-section" id="featured-work">
    <div class="shell">
      <SectionHeading
        eyebrow="Selected work"
        title="Systems that move beyond the notebook."
        description="Applied machine learning is strongest when the data, interface, infrastructure, and operational constraints are designed together."
      />
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2" data-project-grid>
        {featured.map((project) => <ProjectCard project={project} />)}
      </div>
      <div class="hero-actions">
        <a class="button button-secondary" href={withBasePath('/projects/')}>Explore every project <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="page-section section-tint">
    <div class="shell">
      <SectionHeading
        eyebrow="Constellation"
        title="One body of work, connected across domains."
        description="Filter the map to see how machine learning, product engineering, data, and infrastructure reinforce each other."
      />
      <ProjectConstellation projects={projects} />
    </div>
  </section>

  <section class="page-section">
    <div class="shell">
      <CertificationCollection />
    </div>
  </section>

  <section class="page-section">
    <div class="shell">
      <SectionHeading
        eyebrow="Capabilities"
        title="Breadth with a systems-level center."
        description="Skills are grouped by how they contribute to an outcome—not as an unranked wall of technologies."
      />
      <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
        {skillGroups.map((group, index) => (
          <article class="skill-card">
            <span class="skill-index">0{index + 1}</span>
            <h3>{group.label}</h3>
            <p>{group.description}</p>
            <ul class="tag-list" aria-label={`${group.label} tools`}>
              {group.skills.map((skill) => <li>{skill}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section section-tint">
    <div class="shell profile-grid grid gap-12 lg:grid-cols-[minmax(0,.9fr)_minmax(0,1.1fr)] lg:gap-24">
      <div>
        <p class="eyebrow">Education and direction</p>
        <h2>Engineering the whole path from signal to service.</h2>
      </div>
      <div class="stack-lg">
        <div class="profile-copy">
          <p>I’m a <strong>Computer Engineering student specializing in Data Science</strong> at the Technological Institute of the Philippines.</p>
          <p>My work sits between applied machine learning and product engineering: preparing data, evaluating models, building interfaces and services, then deploying them on infrastructure I can operate directly.</p>
          <p>I’m targeting early-career opportunities where model quality and software quality are treated as one engineering problem.</p>
        </div>
        <div class="education-card">
          <h3>{site.school}</h3>
          <p>{site.degree}</p>
          <span class="mono">Location / {site.location}</span>
        </div>
        <a class="text-link" href={withBasePath('/about/')}>More about my approach <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="shell contact-panel">
      <p class="eyebrow">Start a conversation</p>
      <h2>Have a role, collaboration, or hard problem in mind?</h2>
      <p>I’m interested in applied ML, data science, and software opportunities where I can contribute across the path from experimentation to deployment.</p>
      <div class="hero-actions">
        <a class="button" href={`mailto:${site.email}`}>Email {site.email}</a>
        <a class="button button-secondary" href={site.github} target="_blank" rel="noopener noreferrer">GitHub <span class="sr-only">(opens in new tab)</span><span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
