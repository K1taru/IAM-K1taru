---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — IAM-K1taru" description="The requested page could not be found.">
  <section class="not-found shell">
    <div>
      <p class="eyebrow">Route not found</p>
      <h1>404</h1>
      <p>This path is outside the current project map. Return to the portfolio or browse the case studies.</p>
      <div class="hero-actions justify-center">
        <a class="button" href="/">Return home</a>
        <a class="button button-secondary" href="/projects/">View projects</a>
      </div>
    </div>
  </section>
</BaseLayout>

